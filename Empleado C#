using System;
public class Empleado {
    public string nombre;
    public string apellidoPaterno;
    public double salarioMensual;
    
    public Empleado () {
        nombre = "";
        apellidoPaterno = "";
        salarioMensual = 0.0;
    }
    public double obtenerSalarioAnual() {
        return salarioMensual * 12;
    }
}
public class EmpleadoTest {
    static void Main() {
        Empleado emp1 = new Empleado();
        Empleado emp2 = new Empleado();
        
        Console.Write("Ingresa el nombre del Empleado 1: ");
        emp1.nombre = Console.ReadLine();
        
        Console.Write("Ingresa el apellido del Empleado 1: ");
        emp1.apellidoPaterno = Console.ReadLine();

        Console.WriteLine("Ingresa salario mensual del Empleado 1: ");
        emp1.salarioMensual = double.Parse(Console.ReadLine());
        
        if (emp1.salarioMensual < 0) {
            emp1.salarioMensual = 0.0;
        }
        
        Console.Write("Ingresa el nombre del Empleado 2: ");
        emp2.nombre = Console.ReadLine();
        
        Console.Write("Ingresa el apellido del Empleado 2: ");
        emp2.apellidoPaterno = Console.ReadLine();

        Console.WriteLine("Ingresa salario mensual del Empleado 2: ");
        emp2.salarioMensual = double.Parse(Console.ReadLine());
        
        if (emp2.salarioMensual < 0) {
            emp2.salarioMensual = 0.0;
        }
        
        Console.WriteLine(" Datos ");
        Console.WriteLine("Nombre del empleado 1: " + emp1.nombre);
        Console.WriteLine("Apellido paterno del empleado 1: " + emp1.apellidoPaterno);
        Console.WriteLine("Salario mensual: " + emp1.salarioMensual);
        Console.WriteLine("Salario Anual: " + emp1.obtenerSalarioAnual());
        Console.WriteLine("");
        Console.WriteLine(" Datos ");
        Console.WriteLine("Nombre del empleado 2: " + emp2.nombre);
        Console.WriteLine("Apellido paterno del empleado 2: " + emp2.apellidoPaterno);
        Console.WriteLine("Salario mensual: " + emp2.salarioMensual);
        Console.WriteLine("Salario Anual: " + emp2.obtenerSalarioAnual());
    }
}
