class Empleado:
    def __init_(self):
        #Atributos inicializados en el constructor __init__
        self.nombre = ""
        self.apellidoPaterno = ""
        self.salarioMensual = 0.0
        
    def obtenerSalarioAnual(self):
        return self.salarioMensual*12
        
